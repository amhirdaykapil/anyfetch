# ==============================================================================
# AnyFetch — Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local with real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Binaries (Optional)
# ------------------------------------------------------------------------------
# AnyFetch automatically resolves 'python' (or 'python3') and 'ffmpeg' from your
# system PATH. Set custom absolute paths only if binaries are installed in non-standard locations.
PYTHON_PATH=
FFMPEG_PATH=

# ------------------------------------------------------------------------------
# 2. Reddit API Credentials (Optional)
# ------------------------------------------------------------------------------
# AnyFetch extracts public Reddit posts, gallery carousels, and CMAF video streams
# without credentials. Provide Reddit OAuth app credentials to enable higher rate limits.
# Obtain from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=web:anyfetch:v2.5 (by /u/your_reddit_username)

# ------------------------------------------------------------------------------
# 3. Instagram & Meta Extraction (Optional)
# ------------------------------------------------------------------------------
# AnyFetch extracts public Instagram posts, reels, and multi-slide carousels
# via public HTML/Polaris payloads and direct CDN streams without credentials.
# For high-volume production deployments, configure one of the following providers:

# Option A: RapidAPI Instagram Service
RAPIDAPI_KEY=your_rapidapi_key_here

# Option B: Meta Graph API Token (for official oEmbed)
# Obtain from: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here

# Option C: Custom Instagram Proxy API
INSTAGRAM_API_URL=
INSTAGRAM_API_KEY=
